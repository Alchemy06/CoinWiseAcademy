# OpenAI key used by the Django backend proxy
OPENAI_API_KEY=your_openai_api_key_here

# Optional backend settings
CHAT_ENABLE_WEB_SEARCH=1
QUIZ_GENERATION_MODEL=gpt-5-mini
QUIZ_GENERATION_MAX_OUTPUT_TOKENS=4200
QUIZ_GENERATION_REASONING_EFFORT=low
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend override. Leave unset when Caddy or Vite proxies /api on the same origin.
# VITE_API_BASE_URL=https://your-domain.example
